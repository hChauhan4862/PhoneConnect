# Copy this file to docker/.env and fill it in. docker/.env is git-ignored and must never be
# committed: it holds the admin bearer token.

# The published image. Pin a release tag; `latest` moves under you.
PHONECONNECT_IMAGE=ghcr.io/hchauhan4862/phoneconnect/server:0.1.1

# Required. Bearer token for the admin API and the web UI, and the only credential that can
# enroll a device, dispatch a command, or read the audit log. Generate one with:
#
#   openssl rand -base64 32
#
PHONECONNECT_ADMIN_TOKEN=

# Required. The origin phones and desktops dial: the public HTTPS address your reverse proxy
# serves. The server advertises it as the relay base, so it must be reachable from the devices,
# not just from the host. No trailing slash.
PHONECONNECT_PUBLIC_URL=https://phoneconnect.example.com

# Where the container publishes. Leave it on loopback and let the reverse proxy reach it; the
# server speaks plain HTTP and expects TLS to be terminated in front of it.
PHONECONNECT_BIND_ADDRESS=127.0.0.1
PHONECONNECT_PORT=8080
