<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Required by android:foregroundServiceType="connectedDevice". -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Required by android:foregroundServiceType="mediaProjection": screen.snapshot captures
         only while the user has enabled screen capture on the setup screen, never on its own. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- apps.list: Android 11+ hides other installed apps from a package unless it declares
         this. Listing installed apps is the whole point of apps.list; without the permission
         the answer would be only the handful of packages the system chooses to reveal, which
         is not the device's app inventory. Play policy restricts QUERY_ALL_PACKAGES to apps
         whose core purpose needs it and requires a declaration; this is a self-hosted device
         management agent, and android/README.md states the implication.

         Lint recommends a <queries> declaration instead. That is the right tool for an app
         that talks to a few known packages; it cannot express "every installed app", which
         is exactly what apps.list must report. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- apps.stop: lets the agent ask Android to kill a package's background processes. An
         ordinary app cannot hold the signature-level permissions apps.clear and
         apps.set_enabled would need; those commands refuse explicitly instead. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- control.get reads the Wi-Fi state to report it honestly; changing it is refused
         because Android removed the app-facing setter. This is a read-only normal
         permission. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- control.set brightness: a user-granted setting, allowed from the system's
         ACTION_MANAGE_WRITE_SETTINGS screen, which the setup screen opens. Declared so the
         grant can apply; without it the command answers not_permitted
         write_settings_required instead of pretending to change the screen. -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- control.set dnd_filter: notification-policy (Do Not Disturb) access is granted by the
         user on ACTION_NOTIFICATION_POLICY_ACCESS_SETTINGS, which the setup screen opens.
         Without it the command answers not_permitted policy_access_required. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- The battery-optimisation exemption is a request the user can refuse. Android and OEM
         battery managers may still stop a foreground service; the setup screen asks for the
         exemption and then reports what Android says, rather than promising the app cannot be
         stopped. The scoped request dialog needs this permission.

         Play policy: REQUEST_IGNORE_BATTERY_OPTIMIZATIONS is restricted, granted only to app
         categories Play names (for example alarm and VoIP apps). This project distributes the
         agent as a sideloaded APK from its own releases, never through Play, so the restriction
         does not gate shipping it; a Play listing would have to justify or drop it. The lint
         check is suppressed because the trade is known and recorded here, not overlooked. -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />

    <!-- Backup is disabled so the Keystore-wrapped enrollment blob never leaves the device
         and a restore onto different hardware cannot present an undecryptable credential. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_stat_connection"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true">

        <!-- The only foreground service in the agent. Ordinary-app only: no device-owner
             provisioning, and the notification is the user-visible contract.

             `connectedDevice` is the type for a long-lived authenticated connection: it may
             be started from BOOT_COMPLETED on Android 15 and is not subject to the six-hour
             dataSync cap. It requires FOREGROUND_SERVICE_CONNECTED_DEVICE plus a qualifying
             runtime permission (CHANGE_NETWORK_STATE here).

             `mediaProjection` is added because screen.snapshot mirrors the display, and only
             while the user has enabled screen capture: the service is started with both types
             before the projection token is used, because Android 14+ requires the type to be
             running when the token is acquired. It is still one service and one notification. -->
        <service
            android:name=".ConnectionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|mediaProjection"
            android:stopWithTask="false" />

        <!-- The only screen: hub URL, one-time enrollment token, status and recovery. -->
        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Boot and post-update recovery. It only asks for the one service; the service
             decides whether an enrollment exists. -->
        <receiver
            android:name=".RecoveryReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
