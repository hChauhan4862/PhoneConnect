<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Required by android:foregroundServiceType="connectedDevice". -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Backup is disabled so the Keystore-wrapped enrollment blob never leaves the device
         and a restore onto different hardware cannot present an undecryptable credential. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_stat_connection"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true">

        <!-- The only foreground service in the agent. Ordinary-app only: no device-owner
             provisioning, and the notification is the user-visible contract.

             `connectedDevice` is the type for a long-lived authenticated connection: it may
             be started from BOOT_COMPLETED on Android 15 and is not subject to the six-hour
             dataSync cap. It requires FOREGROUND_SERVICE_CONNECTED_DEVICE plus a qualifying
             runtime permission (CHANGE_NETWORK_STATE here). -->
        <service
            android:name=".ConnectionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice"
            android:stopWithTask="false" />

        <!-- The only screen: hub URL, one-time enrollment token, status and recovery. -->
        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Boot and post-update recovery. It only asks for the one service; the service
             decides whether an enrollment exists. -->
        <receiver
            android:name=".RecoveryReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
