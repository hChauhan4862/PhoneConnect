<?xml version="1.0" encoding="utf-8"?>
<!-- The mark as a vector, so the launcher renders it crisply at any density.

     Drawn in Android's 108x108 adaptive-icon viewport. The artwork's outer diameter is
     64.8 units, inside the 66-unit safe circle a launcher is guaranteed not to mask.
     Proportions match assets/icon.svg: ring inner = 0.8434 of the outer radius,
     disc = 0.7207, dot = 0.3297. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ring: outer 32.4, inner 27.33, filled even-odd so the centre stays transparent. -->
    <path
        android:fillColor="#ecfeff"
        android:fillType="evenOdd"
        android:pathData="M54,21.6a32.4,32.4 0 1,0 0,64.8a32.4,32.4 0 1,0 0,-64.8z M54,26.67a27.33,27.33 0 1,0 0,54.66a27.33,27.33 0 1,0 0,-54.66z" />

    <!-- Disc. -->
    <path
        android:fillColor="#2dd4bf"
        android:pathData="M54,30.65a23.35,23.35 0 1,0 0,46.7a23.35,23.35 0 1,0 0,-46.7z" />

    <!-- Centre dot. -->
    <path
        android:fillColor="#ecfeff"
        android:pathData="M54,43.32a10.68,10.68 0 1,0 0,21.36a10.68,10.68 0 1,0 0,-21.36z" />
</vector>
