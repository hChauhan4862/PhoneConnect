<?xml version="1.0" encoding="utf-8"?>
<!-- targetSdk 35 denies cleartext by default, but the hub may be a loopback HTTP origin
     (the compose default is http://127.0.0.1:8080). Cleartext is permitted for loopback
     literals only; every other host still requires TLS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">::1</domain>
    </domain-config>
</network-security-config>
